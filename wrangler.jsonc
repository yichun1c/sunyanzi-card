{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sunyanzi-card",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "yichun1c.dpdns.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
